{
  "description": "agent-notify：回合结束、需要授权时发送 Telegram 通知（Codex CLI）",
  "hooks": {
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 \"$PLUGIN_ROOT/notify/bin/hook.py\" codex", "statusMessage": "agent-notify：回合结束通知", "async": true, "timeout": 15}]}
    ],
    "PermissionRequest": [
      {"hooks": [{"type": "command", "command": "python3 \"$PLUGIN_ROOT/notify/bin/hook.py\" codex", "statusMessage": "agent-notify：授权请求通知", "async": true, "timeout": 15}]}
    ]
  }
}
